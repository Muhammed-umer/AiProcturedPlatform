DATABASE_URL=postgres://postgres:postgres@localhost:5432/placement_test
SESSION_SECRET=change-this-to-a-long-random-string-before-deploying
DEFAULT_STUDENT_PASSWORD=Welcome@123

# Set to true once the app is served over HTTPS. Browsers only allow webcam
# access on HTTPS or localhost, so the camera-proctored exam needs it on the
# lab server. Leave false for plain-HTTP development.
SECURE_COOKIES=false

# Set to "off" to let a student start a test without the camera first
# confirming their face is visible. On by default; leave it alone unless the
# lab's webcams defeat the detector. It does not affect the warnings raised
# during a test.
PROCTOR_FACE_GATE=on

# Optional. Only needed for Word/PDF question extraction, which runs while
# staff prepare a test. Leave blank to use spreadsheet import only.
ANTHROPIC_API_KEY=
